# API
BASE_URL=https://api.cleanlink.com
API_VERSION=/v1/mobile
REQUEST_TIMEOUT=30000

# Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Notifications
FCM_TOPIC=cleanlink_users

# App Behavior
DEBUG=true
ENABLE_LOGS=true

# Feature Flags
ENABLE_CHAT=true
ENABLE_RATINGS=true
ENABLE_TRACKING=true

# Pagination / Limits
DEFAULT_PAGE_SIZE=10
MAX_BOOKING_PER_DAY=3